{
  "model": "sonnet",
  "modelSettings": {
    "sonnet": {
      "effortLevel": "medium"
    }
  },
  "statusLine": {
    "type": "command",
    "command": "in=$(cat); d=$(printf '%s' \"$in\" | python3 -c 'import json,sys;print(json.load(sys.stdin).get(\"workspace\",{}).get(\"project_dir\",\"\"))'); printf '%s' \"$in\" | \"${d:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/.claude/statusline.sh\"",
    "padding": 0
  },
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "permissions": {
    "deny": [
      "Skill(dataviz)",
      "Skill(simplify)",
      "Skill(fewer-permission-prompts)",
      "Skill(keybindings-help)",
      "Skill(update-config)",
      "Task(statusline-setup)",
      "EnterWorktree",
      "ExitWorktree",
      "Read(~/.secrets/**)",
      "Read(~/.zshrc)",
      "Bash(cat ~/.secrets/*)"
    ]
  },
  "skillOverrides": {
    "dataviz": "off",
    "simplify": "off",
    "fewer-permission-prompts": "off",
    "keybindings-help": "off",
    "update-config": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|EnterWorktree|ExitWorktree|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/forbid-worktrees.sh\""
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "attribution": false
}
