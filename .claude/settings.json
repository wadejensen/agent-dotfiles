{
  "model": "sonnet",
  "modelSettings": {
    "sonnet": {
      "effortLevel": "medium"
    }
  },
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "permissions": {
    "deny": [
      "Skill(dataviz)",
      "Skill(simplify)",
      "Skill(fewer-permission-prompts)",
      "Skill(keybindings-help)",
      "Skill(update-config)",
      "Task(statusline-setup)",
      "EnterWorktree",
      "ExitWorktree",
      "Read(~/.secrets/**)",
      "Read(~/.zshrc)",
      "Bash(cat ~/.secrets/*)"
    ]
  },
  "skillOverrides": {
    "dataviz": "off",
    "simplify": "off",
    "fewer-permission-prompts": "off",
    "keybindings-help": "off",
    "update-config": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|EnterWorktree|ExitWorktree|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/forbid-worktrees.sh\""
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "enabledPlugins": {
    "wj@agent-dotfiles": true
  },
  "extraKnownMarketplaces": {
    "agent-dotfiles": {
      "source": {
        "source": "directory",
        "path": "~/code/agent-dotfiles"
      }
    }
  },
  "statusLine": {
    "type": "command",
    "command": "~/code/agent-dotfiles/bin/statusline.sh",
    "padding": 0
  }
  },
  "attribution": false
}
