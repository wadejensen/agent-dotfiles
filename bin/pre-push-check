#!/usr/bin/env bash
# git pre-push hook: refuse to push commits that carry agent attribution.
# Installed (as a symlink) by scripts/new-project.sh; resolves its own real
# path so it works from any repo that symlinks to it.
set -euo pipefail
real="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
exec "$(dirname "$real")/git-push" --check
