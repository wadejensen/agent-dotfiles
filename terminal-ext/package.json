{
  "name": "terminal-ext",
  "displayName": "Terminal Ext",
  "description": "Open a split terminal via a URI (cursor:// or vscode://), so it can be triggered from the command line.",
  "publisher": "local",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished", "onUri"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "terminal-ext.openSplitTerminal",
        "title": "Terminal Ext: Open Split Terminal"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "@vscode/vsce": "^2.32.0",
    "typescript": "^5.4.0"
  }
}
